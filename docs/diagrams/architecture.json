  "cards": [
    {
      "dot": "cyan",
      "title": "Indexing time",
      "items": [
        "One pass over the notes writes cards, the attribute table, and body files",
        "Reverse and two-hop edges are computed once, not per question"
      ]
    },
    {
      "dot": "emerald",
      "title": "Query time",
      "items": [
        "The agent reads small files chosen by question type",
        "Full bodies are opened only when a card is not enough"
      ]
    }
